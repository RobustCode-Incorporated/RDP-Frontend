# Frontend API base URL used by axios
# Local example:
# VITE_API_BASE_URL=http://localhost:8080
# Render example:
# VITE_API_BASE_URL=https://robust-delivery-platform-backend.onrender.com
VITE_API_BASE_URL=http://localhost:8080

# Optional: contact email sent to OpenStreetMap Nominatim (address autocomplete),
# as recommended by https://operations.osmfoundation.org/policies/nominatim/
VITE_NOMINATIM_EMAIL=
# Optional: self-hosted / commercial Nominatim-compatible endpoint
# VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org
